{
  "name": "opencode-subagent-studio",
  "version": "0.1.0",
  "description": "Manage OpenCode V2 subagents from the OpenCode Desktop settings: view, create, edit, disable, rename and trash subagent markdown files",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "subagent",
    "subagents",
    "agents",
    "desktop",
    "plugin-manager"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "watch": "vite build --watch"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "solid-js": "1.9.17",
    "typescript": "^5.9.3",
    "vite": "7.3.7",
    "vite-plugin-solid": "2.11.10"
  }
}
